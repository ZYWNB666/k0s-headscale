# =============================================================================
# 复制本文件为 .env 并填入你的真实值:  cp .env.example .env && vi .env
# .env 已被 .gitignore 忽略,不会提交。
# 运行 ./render.sh 会把模板渲染成真实配置。
# =============================================================================

# ---------- Headscale 控制面 ----------
# 对外域名(经 SNAT/端口转发 + Caddy 暴露),不要带协议和端口
HEADSCALE_DOMAIN=headscale.example.com
# 对外 HTTPS 端口(Caddy 监听)
HEADSCALE_PORT=3477
# STUN/UDP 端口(必须对公网开放,用于 NAT 穿越)
HEADSCALE_STUN_PORT=3478
# MagicDNS 基础域名(必须与 HEADSCALE_DOMAIN 不同;节点解析为 <host>.<base>)
HEADSCALE_MAGICDNS_BASE=tail.example.com
# 内嵌 DERP 中继区域名/代号
DERP_REGION_CODE=home
DERP_REGION_NAME="Home Embedded DERP"

# 上游 DNS(给 tailnet 节点解析公网域名用)
UPSTREAM_DNS_1=223.5.5.5
UPSTREAM_DNS_2=1.1.1.1

# Headscale 版本
HEADSCALE_IMAGE=headscale/headscale:v0.29.3

# ---------- k0s 集群 ----------
K0S_CLUSTER_NAME=my-k0s
K0S_VERSION=1.36.3+k0s.2

# 使用节点上已安装的 k0s 二进制(true), 不让 k0sctl 从 GitHub 下载(国内极慢)。
# 配合 K0S_BINARY_URL: 部署时(before hook)发现节点无二进制则自动从该地址下载。
# 留空 = 要求节点已预装 /usr/local/bin/k0s(可从任意国内镜像下载后 scp)。
# 例: https://your-oss.example.com/k0s-v1.36.3+k0s.2-amd64
K0S_USE_EXISTING_BINARY=false
K0S_BINARY_URL=

# controller 节点(controller + worker)
K0S_CONTROLLER_HOST=hs-server
K0S_CONTROLLER_IP=100.64.0.1            # 该节点的 Tailscale IP
K0S_CONTROLLER_SSH_USER=root
K0S_CONTROLLER_SSH_PORT=22
K0S_CONTROLLER_SSH_KEY=~/.ssh/id_ed25519

# worker 节点
K0S_WORKER_HOST=my-nas
K0S_WORKER_IP=100.64.0.8                # 该节点的 Tailscale IP
K0S_WORKER_SSH_USER=root
K0S_WORKER_SSH_PORT=22
K0S_WORKER_SSH_KEY=~/.ssh/id_ed25519

# 网络
K0S_POD_CIDR=10.244.0.0/16
K0S_SERVICE_CIDR=10.96.0.0/12
# Tailscale 网卡名(Calico 用它做 VTEP 自动检测,跨 WireGuard 组网必需)
TAILSCALE_IFACE=tailscale0

# ---------- 可选:外部存储(留空 = 用 k0s 默认 etcd) ----------
# 单 controller 用默认 etcd 即可;多 controller 或想用外部 DB 时填 kine 数据源。
# 例: mysql://k0s:CHANGE_ME_PASSWORD@tcp(mysql.example.com:3306)/k0s_kine
# 注意: 配置了 kine 时, deploy.sh 每次部署前会清空该库(脏数据会导致 worker 无法就绪);
#       如需保留设 K0S_WIPE_KINE=false
K0S_KINE_DATASOURCE=
K0S_WIPE_KINE=true

# ---------- 可选:镜像仓库代理(留空 = 直连 quay.io) ----------
# 国内拉取慢时,填 Harbor/仓库代理地址。k0s 只改写 registry 主机名,
# 镜像版本仍用 k0s 自带的正确值(切勿手动钉版本,会造成模板/镜像错配,见 k0s#8199)。
# 两种填法:
#   路径式: harbor.example.com/quay.io   → quay.io/xxx 变为 harbor.example.com/quay.io/xxx
#   域名式: quay.harbor.example.com      → quay.io/xxx 变为 quay.harbor.example.com/xxx
K0S_REGISTRY_PROXY=
